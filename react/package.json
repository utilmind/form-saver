{
    "name": "form-saver-react",
    "version": "0.1.0",
    "description": "React and TypeScript form state persistence helper for localStorage and sessionStorage.",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "eslint \"src/**/*.{ts,tsx}\" \"test/**/*.ts\" \"demo/src/**/*.{ts,tsx}\" \"demo/vite.config.ts\" \"vitest.config.ts\"",
        "lint:fix": "npm run lint -- --fix",
        "format": "prettier --write \"src/**/*.{ts,tsx}\" \"test/**/*.ts\" \"demo/src/**/*.{ts,tsx,css}\" \"package.json\" \"tsconfig.json\" \"tsconfig.eslint.json\" \"vitest.config.ts\" \"eslint.config.js\" \"demo/package.json\" \"demo/tsconfig.json\" \"demo/vite.config.ts\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"test/**/*.ts\" \"demo/src/**/*.{ts,tsx,css}\" \"package.json\" \"tsconfig.json\" \"tsconfig.eslint.json\" \"vitest.config.ts\" \"eslint.config.js\" \"demo/package.json\" \"demo/tsconfig.json\" \"demo/vite.config.ts\"",
        "demo:dev": "npm --prefix demo run dev",
        "demo:build": "npm --prefix demo run build",
        "demo:preview": "npm --prefix demo run preview",
        "test": "vitest",
        "test:run": "vitest run"
    },
    "peerDependencies": {
        "react": ">=18.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@types/node": "^22.19.17",
        "@types/react": ">=18.0.0",
        "@types/react-dom": "^18.3.7",
        "@vitejs/plugin-react": "^6.0.1",
        "eslint": "^9.0.0",
        "eslint-config-prettier": "^10.0.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-simple-import-sort": "^12.0.0",
        "prettier": "^3.5.3",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "typescript": ">=5.0.0",
        "typescript-eslint": "^8.0.0",
        "vite": "^8.0.10",
        "vitest": "^4.1.5"
    }
}
