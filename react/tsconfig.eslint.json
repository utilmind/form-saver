{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "rootDir": ".",
        "paths": {
            "form-saver-react": ["./src/index.ts"]
        }
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "test/**/*.ts",
        "test/**/*.tsx",
        "demo/src/**/*.ts",
        "demo/src/**/*.tsx",
        "demo/src/types/**/*.d.ts",
        "demo/vite.config.ts",
        "vitest.config.ts"
    ]
}
